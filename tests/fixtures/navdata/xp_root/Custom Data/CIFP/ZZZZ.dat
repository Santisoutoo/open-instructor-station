SID:020,5,ZZZ1A,RW32B,ZZALF,ZZ,P,C,EY  ,,,DF,,,,,,,,,3247,0035,+,05000,,,-,210,,,,,,,,,,;
SID:030,5,ZZZ1A,RW32B,ZZARC,ZZ,P,C,E   ,R,,RF,,IZZC,ZZ,P,I,00350,1802,0055,0900,0035,,,,,,,,,,,,,,,,;
SID:040,5,ZZZ1A,RW32B,ZZBRA,ZZ,E,A,E  E,,,TF,,,,,,,,,0450,0138,B,FL140,10000,,,,,,,,,,,,,;
# Malformed - truncated record. Skipped and counted.
SID:050,5,ZZZ1A,RW32B,ZZBAD;
#
