# Hand-written fixture. Every identifier and coordinate below is invented.
# Airport ZZZZ is the ICAO no-location code. No byte comes from any real navdata.
#
# Runways. Coordinates are packed DDMMSSss with HUNDREDTHS of a second last.
#   RW09  N40 00 00.00 / W003 00 00.00 -> ( 40.0      , -3.0       )
#   RW27  N40 00 00.00 / W002 54 00.00 -> ( 40.0      , -2.9       ) displaced 1640 ft
#   RW32L N40 00 30.00 / W003 01 30.00 -> ( 40.0083333, -3.025     )
#   RW32R N40 00 40.50 / W003 02 00.75 -> ( 40.01125  , -3.0335417 )
RWY:RW09,     ,     ,02000,N40000000,W003000000,0000,0050,IZZA,1;
RWY:RW27,     ,     ,02010,N40000000,W002540000,1640,0055,    ,0;
RWY:RW32L,     ,     ,02040,N40003000,W003013000,0000,0048,IZZC,2;
RWY:RW32R,     ,     ,02050,N40004050,W003020075,0330,    ,    ,Q;
# Malformed - no coordinate pair. Skipped and counted, never fatal.
RWY:RW99X,GARBAGE;
